{
  "uid": "docker-host",
  "title": "Docker",
  "tags": [
    "docker",
    "infrastruktur"
  ],
  "timezone": "Asia/Jakarta",
  "schemaVersion": 39,
  "version": 2,
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "value": "${DS_PROMETHEUS}",
          "text": "Prometheus"
        },
        "hide": 0
      },
      {
        "name": "server",
        "type": "query",
        "query": {
          "query": "label_values(container_last_seen, job)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "current": {
          "value": "cadvisor",
          "text": "cadvisor"
        },
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Container Berjalan",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "count(count by (name) (container_last_seen{job=\"$server\",name!=\"\"}))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Total CPU dipakai",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(container_cpu_usage_seconds_total{job=\"$server\",name!=\"\"}[2m])) * 100",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Total Memori dipakai",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 4
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "decimals": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(container_memory_working_set_bytes{job=\"$server\",name!=\"\"})",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "CPU per Container (%)",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "topk(10, sum by (name) (rate(container_cpu_usage_seconds_total{job=\"$server\",name!=\"\"}[2m])) * 100)",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Memori per Container",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "decimals": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "topk(10, sum by (name) (container_memory_working_set_bytes{job=\"$server\",name!=\"\"}))",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Network per Container",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "decimals": 1
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "topk(6, sum by (name) (rate(container_network_receive_bytes_total{job=\"$server\",name!=\"\"}[2m])))",
          "legendFormat": "RX {{name}}",
          "refId": "A"
        },
        {
          "expr": "topk(6, sum by (name) (rate(container_network_transmit_bytes_total{job=\"$server\",name!=\"\"}[2m])))",
          "legendFormat": "TX {{name}}",
          "refId": "B"
        }
      ]
    },
    {
      "id": 7,
      "type": "table",
      "title": "Semua Container",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 24,
        "h": 10
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "CPU %"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 1
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Memory"
            },
            "properties": [
              {
                "id": "unit",
                "value": "bytes"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Net RX"
            },
            "properties": [
              {
                "id": "unit",
                "value": "Bps"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Net TX"
            },
            "properties": [
              {
                "id": "unit",
                "value": "Bps"
              }
            ]
          }
        ]
      },
      "options": {
        "sortBy": [
          {
            "displayName": "CPU %",
            "desc": true
          }
        ]
      },
      "transformations": [
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "name": "Container",
              "Value #A": "CPU %",
              "Value #B": "Memory",
              "Value #C": "Net RX",
              "Value #D": "Net TX"
            }
          }
        }
      ],
      "targets": [
        {
          "expr": "sum by (name) (rate(container_cpu_usage_seconds_total{job=\"$server\",name!=\"\"}[2m])) * 100",
          "format": "table",
          "instant": true,
          "refId": "A"
        },
        {
          "expr": "sum by (name) (container_memory_working_set_bytes{job=\"$server\",name!=\"\"})",
          "format": "table",
          "instant": true,
          "refId": "B"
        },
        {
          "expr": "sum by (name) (rate(container_network_receive_bytes_total{job=\"$server\",name!=\"\"}[2m]))",
          "format": "table",
          "instant": true,
          "refId": "C"
        },
        {
          "expr": "sum by (name) (rate(container_network_transmit_bytes_total{job=\"$server\",name!=\"\"}[2m]))",
          "format": "table",
          "instant": true,
          "refId": "D"
        }
      ]
    }
  ]
}