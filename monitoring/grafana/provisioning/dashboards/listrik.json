    {
      "id": 21,
      "type": "row",
      "title": "Pemakaian Harian (kWh per hari)",
      "gridPos": { "x": 0, "y": 31, "w": 24, "h": 1 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "Harian MCB Rumah",
      "description": "Kenaikan kWh per 24 jam, dikelompokkan harian",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 0, "y": 32, "w": 12, "h": 8 },
      "fieldConfig": {
        "defaults": {
          "unit": "kwatth",
          "decimals": 2,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 80,
            "barWidthFactor": 0.7,
            "lineWidth": 0,
            "pointSize": 0
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "increase(hass_sensor_energy_kwh{entity=\"sensor.mcb_rumah_total_energy\"}[1d])",
          "legendFormat": "MCB Rumah",
          "interval": "1d",
          "refId": "A"
        }
      ]
    },
    {
      "id": 23,
      "type": "timeseries",
      "title": "Harian Kulon vs Wetan",
      "description": "Kenaikan kWh per 24 jam, dikelompokkan harian",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 12, "y": 32, "w": 12, "h": 8 },
