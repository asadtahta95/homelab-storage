      "type": "stat",
      "title": "Total Energi Kulon",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 0, "y": 27, "w": 6, "h": 4 },
      "fieldConfig": {
        "defaults": { "unit": "kwatth", "decimals": 1 },
