    {
      "id": 19,
      "type": "stat",
      "title": "Tegangan Kulon",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 12, "y": 27, "w": 6, "h": 4 },
      "fieldConfig": {
        "defaults": { "unit": "volt", "decimals": 0 },
        "overrides": []
      },
      "targets": [
        {
          "expr": "hass_sensor_voltage_v{entity=\"sensor.kulon_voltage\"}",
          "legendFormat": "Kulon",
          "refId": "A"
        }
      ]
    },
    {
      "id": 20,
      "type": "stat",
      "title": "Tegangan Wetan",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "x": 18, "y": 27, "w": 6, "h": 4 },
      "fieldConfig": {
        "defaults": { "unit": "volt", "decimals": 0 },
        "overrides": []
