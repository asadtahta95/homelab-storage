# Copy to .env next to the immich docker-compose.yml (install.sh does this).
# NEVER commit the real .env to git.

# Main photo/video storage (bind mount on the host)
UPLOAD_LOCATION=/srv/immich/data

# Postgres data lives next to the compose file (local disk, NOT mergerfs)
DB_DATA_LOCATION=./postgres

DB_USERNAME=immich
DB_DATABASE_NAME=immich
# Generated by install.sh
DB_PASSWORD=

IMMICH_VERSION=release
