# Copy to .env and fill in (install.sh does this automatically).
# NEVER commit the real .env to git.

# ---- General ----
TZ=Asia/Jakarta
SITE_NAME=Homelab Drive
STORAGE_PATH=/srv/storage

# ---- Filebrowser + OnlyOffice ----
FB_PORT=8080
FB_ADMIN_USER=admin
# Generated by install.sh - admin bootstrap password (change after first login)
FB_ADMIN_PASS=
DRIVE_DOMAIN=drive.example.com
OFFICE_DOMAIN=office.example.com
# LAN bind for OnlyOffice (tunnel points here). Use 127.0.0.1:8081 or <lan-ip>:8081
OFFICE_BIND=127.0.0.1:8081
# Generated by install.sh
ONLYOFFICE_JWT_SECRET=
# Session signing key for Filebrowser (generated)
FB_AUTH_KEY=

# ---- Immich ----
IMMICH_PORT=2283
IMMICH_VERSION=release
DB_USERNAME=immich
DB_DATABASE_NAME=immich
# Generated by install.sh
DB_PASSWORD=

# ---- Monitoring ----
PROM_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
# Generated by install.sh
GRAFANA_ADMIN_PASSWORD=

# ---- Cloudflare Tunnel (paste your own token, never commit) ----
CLOUDFLARE_TOKEN=
